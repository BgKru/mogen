# ---------------------------------------------------------------------------
# Environment template.
#
# Copy to .env for local development:
#
#   cp .env.example .env
#
# Never commit .env. Never commit real credentials.
# Every value here is a development default, not a production setting.
# See docs/specifications/08_infrastructure.md, Section 9.
# ---------------------------------------------------------------------------

# Compose file list. Uncomment on a GPU host so plain `docker compose` commands
# include the GPU reservation for both ML workers. The separator is `;` on
# Windows and `:` on Linux/macOS. Leave it commented for a CPU-only host.
# COMPOSE_FILE=compose.yaml;compose.gpu.yaml

# Application
APP_NAME=3D Generation Service
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO
ENABLE_API_DOCS=true

# Frontend
FRONTEND_PORT=5173
# Relative base keeps the browser same-origin; the dev server proxies /api.
VITE_API_BASE_URL=/api/v1
VITE_TASK_POLL_INTERVAL=3000
# Client-side hints only. Keep consistent with the backend limits below.
VITE_MAX_UPLOAD_SIZE_MB=20
VITE_MIN_SCENE_IMAGES=3
VITE_MAX_SCENE_IMAGES=100

# Backend
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
SESSION_TTL_HOURS=24
# Development default. Production startup rejects this value.
CSRF_SECRET=dev-only-csrf-secret-change-before-production
# Must be true in production (HTTPS).
SESSION_COOKIE_SECURE=false
# In-process fixed-window limiter for the unauthenticated auth endpoints
# (/auth/login and /auth/register). Counters are per API process.
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
# Maximum page size accepted for project listing pagination.
MAX_PAGE_SIZE=100
CORS_ORIGINS=http://localhost:5173

# PostgreSQL
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://app:change_me@db:5432/app

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# Celery
# Database 1 is reserved for the broker; database 0 serves direct Redis access.
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_TASK_IGNORE_RESULT=true

# Cleanup worker
# Jobs attempted per cycle, how often the worker scans for pending jobs, and
# how many failed attempts a job gets before it is marked FAILED.
CLEANUP_BATCH_SIZE=20
CLEANUP_POLL_INTERVAL_SECONDS=15
CLEANUP_MAX_ATTEMPTS=3
CLEANUP_TASK_TIME_LIMIT_SECONDS=600
# Expired and revoked session rows are deleted by the cleanup worker on this
# beat interval.
SESSION_CLEANUP_INTERVAL_SECONDS=3600
# Scene workspaces kept for diagnostics after a failed/replaced reconstruction
# are pruned once they are this many hours old (0 disables pruning). The sweep
# runs from the cleanup worker's beat schedule (07 Section 15.7).
SCENE_WORKSPACE_RETENTION_HOURS=168
SCENE_WORKSPACE_SWEEP_INTERVAL_SECONDS=3600

# Outbox dispatcher
# Batch size and poll interval control the standalone outbox-dispatcher
# process; the retry policy implements bounded exponential backoff with full
# jitter, and the lock timeout recovers a dispatcher that died after claiming.
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_SECONDS=2
OUTBOX_RETRY_BASE_SECONDS=2
OUTBOX_RETRY_MAX_SECONDS=300
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_LOCK_TIMEOUT_SECONDS=60

# Worker leases and recovery
# The lease is renewed on every heartbeat; a task is stale only when both its
# lease expired and its heartbeat went quiet for the stale threshold.
TASK_LEASE_SECONDS=300
TASK_HEARTBEAT_SECONDS=30
TASK_STALE_THRESHOLD_SECONDS=900
DISPATCH_STALL_TIMEOUT_SECONDS=900
TASK_RECOVERY_MAX_ATTEMPTS=3
RECOVERY_BATCH_SIZE=50
RECOVERY_POLL_INTERVAL_SECONDS=30

# Storage
STORAGE_ROOT=/data
MAX_UPLOAD_SIZE_MB=20
# Longest accepted image edge in pixels.
MAX_IMAGE_DIMENSION=8192
MAX_SCENE_IMAGES=100
MIN_SCENE_IMAGES=3

# Workers
OBJECT_WORKER_CONCURRENCY=1
SCENE_WORKER_CONCURRENCY=1
CLEANUP_WORKER_CONCURRENCY=2
# Celery hard time limits for the generation pipelines (Phase 5/6 execute them).
OBJECT_TASK_TIME_LIMIT_SECONDS=3600
SCENE_TASK_TIME_LIMIT_SECONDS=7200

# TripoSR object generation (06_object_generation.md Section 16).
# The base compose file is CPU-only so the stack starts without NVIDIA
# hardware; compose.gpu.yaml forces cuda:0 and reserves the GPU.
OBJECT_GENERATION_ENABLED=true
OBJECT_MODEL_ID=stabilityai/TripoSR
# Hugging Face model revision (not the TripoSR source commit).
OBJECT_MODEL_REVISION=5b521936b01fbe1890f6f9baed0254ab6351c04a
OBJECT_MODEL_DIR=/models/triposr
# SHA-256 of the pinned model.ckpt (1 677 246 742 bytes).
OBJECT_MODEL_SHA256=429e2c6b22a0923967459de24d67f05962b235f79cde6b032aa7ed2ffcd970ee
OBJECT_DINO_MODEL_ID=facebook/dino-vitb16
OBJECT_DINO_REVISION=f205d5d8e640a89a2b8ef0369670dfc37cc07fc2
OBJECT_DEVICE=cpu
OBJECT_ALLOW_CPU_FALLBACK=true
OBJECT_CHUNK_SIZE=8192
OBJECT_MC_RESOLUTION=256
OBJECT_REMOVE_BACKGROUND=true
OBJECT_FOREGROUND_RATIO=0.85
OBJECT_OUTPUT_FORMAT=glb
OBJECT_BAKE_TEXTURE=false
OBJECT_TEXTURE_RESOLUTION=1024
OBJECT_MAX_TASK_SECONDS=900
OBJECT_WORKER_CONCURRENCY=1
OBJECT_REMBG_MODEL=u2net
OBJECT_INPUT_SIZE=512
OBJECT_WORK_DIR=/tmp/mogen-object-generation

# Object generator policy (13_advanced_object_generation.md Section 6).
# TripoSR remains the default and needs no extra downloads. SF3D is opt-in
# through compose.sf3d.yaml; its weights are gated and live in a dedicated
# cache. Hunyuan3D is not available in this build (licence/territory and 12 GB
# hardware checks were not satisfied), so enabling it makes startup fail
# explicitly instead of silently substituting another model.
# `sf3d-model-init` needs HF_TOKEN: a classic read token whose account accepted
# the Stability AI Community License for the gated repository. Keep the value in
# the gitignored `.env` (or the shell), never in this file. The initializer also
# seeds the DINOv2/open_clip caches under HF_HOME, which the offline worker needs.
OBJECT_GENERATOR=triposr
# Pre-inference fallback to TripoSR only; never after inference has started.
OBJECT_GENERATOR_FALLBACK=false
OBJECT_SF3D_ENABLED=false
OBJECT_SF3D_MODEL_ID=stabilityai/stable-fast-3d
OBJECT_SF3D_MODEL_REVISION=f0c9a8ffd62cb1bbc8a7a53c9f87a0be1b6be778
OBJECT_SF3D_MODEL_DIR=/models/sf3d
OBJECT_SF3D_MANIFEST_PATH=/models/sf3d/model-manifest.json
OBJECT_SF3D_TEXTURE_RESOLUTION=1024
# none | triangle | quad (none is the verified 12 GB path).
OBJECT_SF3D_REMESH=none
OBJECT_SF3D_TARGET_VERTEX_COUNT=-1
OBJECT_HUNYUAN3D_ENABLED=false
# Required together with the territory when Hunyuan3D is enabled.
OBJECT_HUNYUAN3D_LICENSE_ACKNOWLEDGED=false
OBJECT_HUNYUAN3D_TERRITORY=
OBJECT_HUNYUAN3D_MODEL_REVISION=
OBJECT_HUNYUAN3D_MODEL_DIR=/models/hunyuan3d
OBJECT_HUNYUAN3D_MODE=shape
OBJECT_HUNYUAN3D_LOW_VRAM=false
OBJECT_HUNYUAN3D_TEXTURE_ENABLED=false

# Optional post-generation mesh/texture enhancement
# (docs/additions/14_mesh_texture_enhancement.md Section 6). Conservative cleanup
# and normal validation are on; simplification, UV generation, baking and AI
# texture are off. `OBJECT_MESH_MERGE_TOLERANCE` is a fraction of the bounding-box
# diagonal, not a world-unit value. No quadric simplifier is installed in the
# images, so enabling simplification records SIMPLIFIER_UNAVAILABLE and keeps the
# original mesh. Baking works on CPU with xatlas and vertex colours.
OBJECT_MESH_CLEANUP_ENABLED=true
OBJECT_MESH_MERGE_TOLERANCE=0.000001
OBJECT_MESH_REMOVE_SMALL_COMPONENTS=false
OBJECT_MESH_SMALL_COMPONENT_FACES=32
OBJECT_MESH_NORMALS_ENABLED=true
OBJECT_MESH_SIMPLIFICATION_ENABLED=false
OBJECT_MESH_TARGET_FACES=0
OBJECT_MESH_MAX_DEVIATION=0.01
OBJECT_MESH_SMOOTHING_ITERATIONS=0
OBJECT_GENERATE_UV=false
OBJECT_UV_RESOLUTION=1024
OBJECT_UV_PADDING=2
OBJECT_TEXTURE_PADDING=4
# AI texture generation is disabled: no model passed the licence, compatibility,
# cache and RTX 3060 review. Enabling it fails configuration validation.
OBJECT_AI_TEXTURE_ENABLED=false
OBJECT_AI_TEXTURE_BACKEND=disabled

# Scene Reconstruction (COLMAP 4.2.1 + OpenMVS 2.4.0, 07 Section 16).
# The dedicated mogen-scene-worker:dev image contains both toolchains; the
# base compose file runs COLMAP on the CPU, compose.gpu.yaml enables CUDA.
SCENE_RECONSTRUCTION_ENABLED=true
SCENE_COLMAP_EXECUTABLE=/usr/local/bin/colmap
SCENE_OPENMVS_BIN_DIR=/usr/local/bin/OpenMVS
SCENE_WORK_DIR=/data/work/scene
SCENE_MATCHING_STRATEGY=EXHAUSTIVE
SCENE_COLMAP_USE_GPU=false
SCENE_COLMAP_MAX_FEATURES=8192
SCENE_COLMAP_CAMERA_MODEL=SIMPLE_RADIAL
SCENE_MAX_IMAGE_SIZE=2000
SCENE_MAX_THREADS=4
SCENE_OPENMVS_USE_CUDA=false
SCENE_ENABLE_MESH_REFINEMENT=true
SCENE_ENABLE_TEXTURE_GENERATION=true
# Configurable quality thresholds (07 Section 8.6): a usable reconstruction
# needs at least this many registered images, this ratio and this point count.
SCENE_MIN_REGISTERED_IMAGES=3
SCENE_MIN_REGISTRATION_RATIO=0.5
SCENE_MIN_SPARSE_POINTS=100
SCENE_MIN_DENSE_POINTS=100
SCENE_MAX_TASK_SECONDS=14400
SCENE_COLMAP_TIMEOUT_SECONDS=3600
SCENE_OPENMVS_TIMEOUT_SECONDS=5400
SCENE_EXPORT_TIMEOUT_SECONDS=1800
SCENE_OUTPUT_FORMAT=GLB
# Optional neural scene representation (docs/additions/15_neural_scene_reconstruction.md).
# The released COLMAP + OpenMVS mesh path stays the default. Selecting
# gaussian_splat requires SCENE_SPLAT_ENABLED=true and
# SCENE_OUTPUT_FORMAT=PLY, and the dedicated splat worker image
# (compose.splat.yaml). The selection is persisted per task, so changing these
# values never re-targets an already accepted task.
SCENE_REPRESENTATION=mesh
SCENE_SPLAT_ENABLED=false
# Queue consumed by the dedicated splat worker; must differ from the mesh,
# object and cleanup queues.
SCENE_SPLAT_WORKER_QUEUE=scene_gaussian_splat
# Only the standard Splatfacto model is supported on the 12 GB target profile;
# splatfacto-big is rejected by validation.
SCENE_SPLAT_MODEL=splatfacto
SCENE_SPLAT_MAX_ITERATIONS=30000
# Downscale factor in (0.1, 1.0]; the long edge is additionally capped.
SCENE_SPLAT_IMAGE_SCALE=1.0
SCENE_SPLAT_MAX_IMAGE_DIMENSION=1600
SCENE_SPLAT_CHECKPOINT_INTERVAL=5000
# Soft admission budget; the worker refuses to start a task when less free VRAM
# than this is available (the card is never oversubscribed deliberately).
SCENE_SPLAT_MAX_VRAM_MB=9000
SCENE_SPLAT_DEVICE=cuda
# Maximum accepted Gaussian PLY (the browser buffers the whole artifact).
SCENE_SPLAT_MAX_ARTIFACT_BYTES=536870912
# Bounded by SCENE_TASK_TIME_LIMIT_SECONDS.
SCENE_SPLAT_TIMEOUT_SECONDS=7200
SCENE_SPLAT_MIN_REGISTERED_IMAGES=8
SCENE_SPLAT_SH_DEGREE=3
# Interpreter and isolated package directory that carry the pinned
# Nerfstudio/gsplat stack (dedicated neural worker image).
SCENE_SPLAT_PYTHON=/opt/venv/bin/python
SCENE_SPLAT_SITE_PACKAGES=/opt/splat-site
# Set only on the dedicated splat worker container.
SCENE_SPLAT_WORKER=false
# Optional learned feature matching (docs/additions/12_advanced_feature_matching.md).
# SIFT is the default and the fallback. ALIKED + LightGlue runs only in the
# scene worker image and stays opt-in until benchmark evidence supports more.
# scene_feature_profile must match the backend: sift_default for COLMAP_SIFT;
# aliked_lightglue or aliked_lightglue_fast for ALIKED_LIGHTGLUE.
SCENE_FEATURE_BACKEND=COLMAP_SIFT
SCENE_FEATURE_PROFILE=sift_default
SCENE_FEATURE_FALLBACK_TO_SIFT=true
# Neural keypoint ceiling per image (the fast profile caps itself at 1024).
SCENE_FEATURE_MAX_KEYPOINTS=2048
# Long-edge resize before ALIKED inference; keypoints are restored to original
# coordinates before the COLMAP import.
SCENE_FEATURE_IMAGE_MAX_SIZE=1600
# EXHAUSTIVE or SEQUENTIAL; the neural pair list is generated deterministically
# before any inference and bounded by SCENE_FEATURE_MAX_PAIRS.
SCENE_FEATURE_PAIR_STRATEGY=EXHAUSTIVE
SCENE_FEATURE_SEQUENTIAL_OVERLAP=5
# Minimum tentative matches required before a pair is written to the database.
SCENE_FEATURE_MIN_MATCHES=30
# LightGlue confidence threshold in [0, 1].
SCENE_FEATURE_MATCH_THRESHOLD=0.1
# auto, cuda or cpu. Explicit cuda fails clearly when unavailable.
SCENE_FEATURE_DEVICE=auto
# Soft budget for the 12 GB reference GPU; the stage also refuses to start when
# less than 2 GB is free.
SCENE_FEATURE_MAX_VRAM_MB=9000
SCENE_FEATURE_MAX_PAIRS=20000

# Optional post-reconstruction scene enhancement (14 Section 6). Off by default.
# OpenMVS RefineMesh/TextureMesh remain the only refinement/texturing stages;
# scene UVs and atlases are preserved and request-time UV regeneration is
# rejected. Textured geometry is never simplified by the built-in policy.
SCENE_MESH_POSTPROCESS_ENABLED=false
SCENE_MESH_CLEANUP_ENABLED=true
SCENE_NORMALS_ENABLED=true
SCENE_MESH_SIMPLIFICATION_ENABLED=false
SCENE_MESH_TARGET_FACES=0
SCENE_MESH_MAX_DEVIATION=0.01
SCENE_GENERATE_UV=false
SCENE_AI_TEXTURE_ENABLED=false

# Shared enhancement budgets (14 Sections 6 and 8). CPU is the only verified
# device for deterministic atlas/material work in this delivery.
ENHANCEMENT_FALLBACK_TO_ORIGINAL=true
MESH_ENHANCEMENT_MAX_MEMORY_MB=8192
TEXTURE_ENHANCEMENT_DEVICE=cpu

# Advisory image-quality analysis (docs/additions/11_image_quality_analysis.md).
# Both ML workers consume these values. Findings are warnings only: analysis
# never rejects a photograph unless a separate validation rule already failed.
# Units: 8-bit intensity (0-255) for luminance/blur/noise, fractions for
# clipping, pixels for the resolution floor. Defaults are provisional.
IMAGE_QUALITY_ENABLED=true
IMAGE_QUALITY_REQUIRED=false
IMAGE_QUALITY_MAX_ANALYSIS_DIMENSION=1024
IMAGE_QUALITY_BLUR_ANALYSIS_EDGE=512
IMAGE_QUALITY_MIN_SHORT_EDGE=640
IMAGE_QUALITY_BLUR_THRESHOLD=100.0
IMAGE_QUALITY_UNDEREXPOSURE_THRESHOLD=40.0
IMAGE_QUALITY_OVEREXPOSURE_THRESHOLD=215.0
IMAGE_QUALITY_SHADOW_CLIP_LEVEL=5
IMAGE_QUALITY_HIGHLIGHT_CLIP_LEVEL=250
IMAGE_QUALITY_CLIPPING_RATIO_THRESHOLD=0.15
IMAGE_QUALITY_CONTRAST_THRESHOLD=35.0
IMAGE_QUALITY_NOISE_THRESHOLD=15.0
IMAGE_QUALITY_ASPECT_RATIO_MIN=0.2
IMAGE_QUALITY_ASPECT_RATIO_MAX=5.0
IMAGE_QUALITY_NEAR_DUPLICATE_ENABLED=true
IMAGE_QUALITY_NEAR_DUPLICATE_MAX_IMAGES=100
IMAGE_QUALITY_HASH_DISTANCE_THRESHOLD=10
IMAGE_QUALITY_SSIM_ENABLED=true
IMAGE_QUALITY_SSIM_THRESHOLD=0.92

# Model cache
# The persistent named volume `triposr_model_cache` mounts at /models and is
# populated once by the model-init service; tasks never download weights.
