# ---------------------------------------------------------------------------
# Environment template.
#
# Copy to .env for local development:
#
#   cp .env.example .env
#
# Never commit .env. Never commit real credentials.
# Every value here is a development default, not a production setting.
# See docs/specifications/08_infrastructure.md, Section 9.
# ---------------------------------------------------------------------------

# Application
APP_NAME=3D Generation Service
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
ENABLE_API_DOCS=true

# Frontend
FRONTEND_PORT=5173
# Relative base keeps the browser same-origin; the dev server proxies /api.
VITE_API_BASE_URL=/api/v1
VITE_TASK_POLL_INTERVAL=3000
# Client-side hints only. Keep consistent with the backend limits below.
VITE_MAX_UPLOAD_SIZE_MB=20
VITE_MIN_SCENE_IMAGES=3
VITE_MAX_SCENE_IMAGES=100

# Backend
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
SESSION_TTL_HOURS=24
# Development default. Production startup rejects this value.
CSRF_SECRET=dev-only-csrf-secret-change-before-production
# Must be true in production (HTTPS).
SESSION_COOKIE_SECURE=false
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
# Maximum page size accepted for project listing pagination.
MAX_PAGE_SIZE=100
CORS_ORIGINS=http://localhost:5173

# PostgreSQL
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://app:change_me@db:5432/app

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# Celery
# Database 1 is reserved for the broker; database 0 serves direct Redis access.
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_TASK_IGNORE_RESULT=true

# Cleanup worker
# Jobs attempted per cycle, how often the worker scans for pending jobs, and
# how many failed attempts a job gets before it is marked FAILED.
CLEANUP_BATCH_SIZE=20
CLEANUP_POLL_INTERVAL_SECONDS=15
CLEANUP_MAX_ATTEMPTS=3
CLEANUP_TASK_TIME_LIMIT_SECONDS=600

# Outbox dispatcher
# Batch size and poll interval control the standalone outbox-dispatcher
# process; the retry policy implements bounded exponential backoff with full
# jitter, and the lock timeout recovers a dispatcher that died after claiming.
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_SECONDS=2
OUTBOX_RETRY_BASE_SECONDS=2
OUTBOX_RETRY_MAX_SECONDS=300
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_LOCK_TIMEOUT_SECONDS=60

# Worker leases and recovery
# The lease is renewed on every heartbeat; a task is stale only when both its
# lease expired and its heartbeat went quiet for the stale threshold.
TASK_LEASE_SECONDS=300
TASK_HEARTBEAT_SECONDS=30
TASK_STALE_THRESHOLD_SECONDS=900
DISPATCH_STALL_TIMEOUT_SECONDS=900
TASK_RECOVERY_MAX_ATTEMPTS=3
RECOVERY_BATCH_SIZE=50
RECOVERY_POLL_INTERVAL_SECONDS=30

# Storage
STORAGE_ROOT=/data
MAX_UPLOAD_SIZE_MB=20
# Longest accepted image edge in pixels.
MAX_IMAGE_DIMENSION=8192
MAX_SCENE_IMAGES=100
MIN_SCENE_IMAGES=3

# Workers
OBJECT_WORKER_CONCURRENCY=1
SCENE_WORKER_CONCURRENCY=1
CLEANUP_WORKER_CONCURRENCY=2
# Celery hard time limits for the generation pipelines (Phase 5/6 execute them).
OBJECT_TASK_TIME_LIMIT_SECONDS=3600
SCENE_TASK_TIME_LIMIT_SECONDS=7200

# TripoSR
OBJECT_DEVICE=cuda:0
OBJECT_ALLOW_CPU_FALLBACK=false
OBJECT_CHUNK_SIZE=8192
OBJECT_MC_RESOLUTION=256
OBJECT_MODEL_REVISION=d26e33181947bbbc4c6fc0f5734e1ec6c080956e

# Scene Reconstruction
SCENE_COLMAP_USE_GPU=true
SCENE_OPENMVS_USE_CUDA=false
SCENE_MAX_THREADS=4
SCENE_MAX_IMAGE_SIZE=2000

# Model cache
MODEL_CACHE_ROOT=/models/triposr
