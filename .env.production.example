# ---------------------------------------------------------------------------
# Production environment template (roadmap 10.1; 08_infrastructure.md Section 9)
#
# Copy this file outside version control (for example .env.production), fill in
# the secrets and start the production overlay with it:
#
#   docker compose --env-file .env.production \
#     -f compose.yaml -f compose.prod.yaml -f compose.gpu.yaml up -d --build
#
# Never commit the filled file. Values marked REQUIRED have no safe default and
# make `docker compose config` fail when missing. Generate secrets with the
# commands shown in docs/deployment.md; use hex/URL-safe values because the
# PostgreSQL password is embedded in DATABASE_URL.
# ---------------------------------------------------------------------------

# Application identity and behaviour.
APP_ENV=production
DEBUG=false
APP_VERSION=1.0.0
LOG_LEVEL=INFO
# API documentation (Swagger/OpenAPI) is disabled on the public deployment.
ENABLE_API_DOCS=false
# The only browser origin accepted by CSRF-protected calls. Must match the
# public HTTPS origin exactly (scheme + host, no trailing slash).
PUBLIC_ORIGIN=https://your-domain.example

# Reverse proxy.
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
# Directory containing tls.crt and tls.key; mounted read-only by the frontend.
TLS_CERT_DIR=./infrastructure/certs

# PostgreSQL (REQUIRED). Use a URL-safe secret: it is embedded in DATABASE_URL
# by compose.prod.yaml.
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=replace-with-a-long-url-safe-secret

# CSRF signing key (REQUIRED, at least 32 characters). Production startup
# refuses the development default.
CSRF_SECRET=replace-with-at-least-32-random-characters

# Cookies are Secure-only behind the HTTPS reverse proxy. The application
# refuses production startup when this is false.
SESSION_COOKIE_SECURE=true

# Unauthenticated auth endpoints are rate limited per API process.
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Worker/resource limits; keep the base defaults unless the hardware differs.
CLEANUP_WORKER_CONCURRENCY=2
OBJECT_WORKER_CONCURRENCY=1
SCENE_WORKER_CONCURRENCY=1

# Object generator policy (13_advanced_object_generation.md). The released
# production images keep the TripoSR default. Enabling SF3D requires the
# dedicated image target (compose.sf3d.yaml), the gated weights and a pinned
# revision; Hunyuan3D is not available in this build.
OBJECT_GENERATOR=triposr
OBJECT_GENERATOR_FALLBACK=false
OBJECT_SF3D_ENABLED=false
OBJECT_SF3D_MODEL_ID=stabilityai/stable-fast-3d
OBJECT_SF3D_MODEL_REVISION=f0c9a8ffd62cb1bbc8a7a53c9f87a0be1b6be778
OBJECT_SF3D_MODEL_DIR=/models/sf3d
OBJECT_SF3D_MANIFEST_PATH=/models/sf3d/model-manifest.json
OBJECT_SF3D_TEXTURE_RESOLUTION=1024
OBJECT_SF3D_REMESH=none
OBJECT_SF3D_TARGET_VERTEX_COUNT=-1

# Post-generation mesh/texture enhancement (increment 14). Conservative object
# cleanup and normals are on by default; scene post-processing and every
# generative/destructive option stay off. AI texture generation is unavailable.
OBJECT_MESH_CLEANUP_ENABLED=true
OBJECT_MESH_NORMALS_ENABLED=true
OBJECT_MESH_SIMPLIFICATION_ENABLED=false
OBJECT_GENERATE_UV=false
OBJECT_BAKE_TEXTURE=false
OBJECT_UV_RESOLUTION=1024
OBJECT_TEXTURE_RESOLUTION=1024
OBJECT_AI_TEXTURE_ENABLED=false
SCENE_MESH_POSTPROCESS_ENABLED=false
SCENE_MESH_SIMPLIFICATION_ENABLED=false
SCENE_GENERATE_UV=false
SCENE_AI_TEXTURE_ENABLED=false
ENHANCEMENT_FALLBACK_TO_ORIGINAL=true
MESH_ENHANCEMENT_MAX_MEMORY_MB=8192
TEXTURE_ENHANCEMENT_DEVICE=cpu

# Optional neural scene representation (increment 15). The production default is
# the released COLMAP + OpenMVS mesh path. Selecting gaussian_splat requires the
# dedicated neural worker image/overlay (compose.splat.yaml), a GPU, and the
# matching pair SCENE_SPLAT_ENABLED=true / SCENE_OUTPUT_FORMAT=PLY.
SCENE_REPRESENTATION=mesh
SCENE_SPLAT_ENABLED=false
SCENE_SPLAT_WORKER_QUEUE=scene_gaussian_splat
SCENE_SPLAT_MODEL=splatfacto
SCENE_SPLAT_MAX_ITERATIONS=30000
SCENE_SPLAT_IMAGE_SCALE=1.0
SCENE_SPLAT_MAX_IMAGE_DIMENSION=1600
SCENE_SPLAT_CHECKPOINT_INTERVAL=5000
SCENE_SPLAT_MAX_VRAM_MB=9000
SCENE_SPLAT_DEVICE=cuda
SCENE_SPLAT_MAX_ARTIFACT_BYTES=536870912
SCENE_SPLAT_TIMEOUT_SECONDS=7200
SCENE_SPLAT_MIN_REGISTERED_IMAGES=8
SCENE_SPLAT_SH_DEGREE=3
SCENE_SPLAT_PYTHON=/opt/venv/bin/python
SCENE_SPLAT_SITE_PACKAGES=/opt/splat-site
SCENE_SPLAT_WORKER=false

# Scheduled backups (roadmap 10.3). BACKUP_HOST_DIR is bind-mounted to
# /backups; it must be outside the Docker data root and copied off-host.
BACKUP_HOST_DIR=./.backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# Bounded Docker json-file logs (10 MB x 5 per service).
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Optional learned scene feature matching (increment 12). SIFT remains the
# default and the fallback; enable neural mode only with benchmark evidence.
# SCENE_FEATURE_BACKEND=COLMAP_SIFT
# SCENE_FEATURE_PROFILE=sift_default
# SCENE_FEATURE_FALLBACK_TO_SIFT=true
# SCENE_FEATURE_MAX_KEYPOINTS=2048
# SCENE_FEATURE_IMAGE_MAX_SIZE=1600
# SCENE_FEATURE_PAIR_STRATEGY=EXHAUSTIVE
# SCENE_FEATURE_SEQUENTIAL_OVERLAP=5
# SCENE_FEATURE_MIN_MATCHES=30
# SCENE_FEATURE_MATCH_THRESHOLD=0.1
# SCENE_FEATURE_DEVICE=auto
# SCENE_FEATURE_MAX_VRAM_MB=9000
# SCENE_FEATURE_MAX_PAIRS=20000

# Optional overrides. The defaults point at the internal Compose services and
# must not be changed to public host names.
# CELERY_BROKER_URL=redis://redis:6379/1
